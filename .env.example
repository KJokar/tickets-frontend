# Backend origin only (no /api suffix). Defaults to the local Ticketing API.
# Restart Next.js after changing it.
AUTH_BACKEND_ORIGIN=http://localhost:5080

# Optional browser API origin (no path); leave empty to use same-origin rewrites.
# Set before npm run build in production. Covers authentication, tickets and SignalR.
NEXT_PUBLIC_API_ORIGIN=
NEXT_PUBLIC_CDN_ORIGIN=http://localhost:5083
